[Unit]
Description=OpenRouter Better Proxy
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openrouter-better-proxy
ExecStart=/opt/openrouter-better-proxy/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8787 --log-level info
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openrouter-better-proxy/data /opt/openrouter-better-proxy/logs

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openrouter-better-proxy

[Install]
WantedBy=multi-user.target
